# Optional Telegram alerts. Copy this file to .env (which git ignores) and fill in both values.
# 1. In Telegram, talk to @BotFather -> /newbot -> copy the token.
# 2. Send any message to your new bot, then open https://api.telegram.org/bot<TOKEN>/getUpdates
#    in a browser and copy "chat":{"id": ...}.
BGPW_TELEGRAM_TOKEN=
BGPW_TELEGRAM_CHAT_ID=
